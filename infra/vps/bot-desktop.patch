+++ b/infra/sandboxes/computer/rakazo-desktop-launch
@@ -0,0 +1,21 @@
+#!/bin/sh
+# Starts an app from the bot desktop's panel with the bot's normal environment: its shared
+# ~/.config, and no desktop-session markers, so the app outlives a panel restart.
+# File manager and terminal stay on this display's own D-Bus session, so an instance already
+# open on another bot's display never answers for this one.
+set -eu
+browser="${RAKAZO_DESKTOP_BROWSER:-/usr/local/bin/rakazo-browser}"
+unset XDG_CONFIG_HOME GTK_THEME RAKAZO_DESKTOP_DISPLAY RAKAZO_DESKTOP_SESSION RAKAZO_DESKTOP_BROWSER
+cd "$HOME"
+case "${1:-}" in
+  browser)
+    # The browser joins the computer's session bus itself (its file chooser needs that portal).
+    unset DBUS_SESSION_BUS_ADDRESS
+    exec "$browser"
+    ;;
+  "")
+    echo "usage: rakazo-desktop-launch browser|COMMAND [ARGS...]" >&2
+    exit 2
+    ;;
+  *) exec "$@" ;;
+esac
diff --git a/infra/sandboxes/computer/rakazo-desktop-session b/infra/sandboxes/computer/rakazo-desktop-session
new file mode 100644
index 000000000..b48f0f71e
--- /dev/null
+++ b/infra/sandboxes/computer/rakazo-desktop-session
@@ -0,0 +1,155 @@
+#!/usr/bin/env bash
+# The bot desktop on one display: the Xfce window manager and a single bottom panel
+# (Applications, Browser, File Manager, Terminal, open windows, clock).
+#
+# start.sh runs it for the first display. The runtime starts every other display with
+# `fluxbox -rc /tmp/fluxbox-home-N/.fluxbox/init` and stops it with
+# `pkill -f "fluxbox -rc /tmp/fluxbox-home-N/.fluxbox/init"`; /usr/local/bin/fluxbox links
+# here, so this process carries that command line and those commands drive it unchanged.
+#
+# Runs as the computer's own user. Each display gets its own D-Bus session and its own
+# panel settings, kept per bot under ~/.config/rakazo-desktop so they survive restarts.
+# Starting again on a display replaces the earlier session there, so panels never double.
+set -uo pipefail
+
+: "${DISPLAY:?DISPLAY is required}"
+export HOME="${HOME:-/home/rakazo}"
+display_number="${DISPLAY#:}"
+display_number="${display_number%%.*}"
+case "$display_number" in
+  '' | *[!0-9]*)
+    echo "unsupported DISPLAY $DISPLAY" >&2
+    exit 2
+    ;;
+esac
+
+# Every process this session starts carries both markers: the display one finds a session
+# left over on this display, the session one finds only this session's own processes.
+session_id="$$-$(date +%s%N)"
+export RAKAZO_DESKTOP_DISPLAY="$DISPLAY"
+export RAKAZO_DESKTOP_SESSION="$session_id"
+# Panel launchers start the bot's browser through this, whatever display it runs on.
+export RAKAZO_DESKTOP_BROWSER="${BROWSER:-/usr/local/bin/rakazo-browser}"
+
+runtime="/tmp/rakazo/desktop-$display_number"
+log="/tmp/rakazo/desktop-$display_number.log"
+mkdir -p /tmp/rakazo "$runtime"
+exec >>"$log" 2>&1
+
+# Processes whose environment carries `NAME=value`, other than this script.
+marked_pids() {
+  local proc pid
+  for proc in /proc/[0-9]*; do
+    pid="${proc#/proc/}"
+    [[ "$pid" == "$$" ]] && continue
+    if tr '\0' '\n' <"$proc/environ" 2>/dev/null | grep -qxF -- "$1"; then
+      printf '%s\n' "$pid"
+    fi
+  done
+}
+
+stop_marked() {
+  local pids
+  pids="$(marked_pids "$1")"
+  [[ -n "$pids" ]] || return 0
+  # shellcheck disable=SC2086
+  kill -TERM $pids 2>/dev/null || true
+  for _ in $(seq 1 30); do
+    pids="$(marked_pids "$1")"
+    [[ -n "$pids" ]] || return 0
+    sleep 0.1
+  done
+  # shellcheck disable=SC2086
+  kill -KILL $pids 2>/dev/null || true
+}
+
+cleanup() {
+  trap - TERM INT EXIT
+  stop_marked "RAKAZO_DESKTOP_SESSION=$session_id"
+  rm -rf "$runtime"
+  exit 0
+}
+
+# A session already on this display (an earlier start, or one a restart left behind).
+stop_marked "RAKAZO_DESKTOP_DISPLAY=$DISPLAY"
+trap cleanup TERM INT EXIT
+
+ready=0
+for _ in $(seq 1 100); do
+  if xdpyinfo -display "$DISPLAY" >/dev/null 2>&1; then
+    ready=1
+    break
+  fi
+  sleep 0.1
+done
+if [[ "$ready" -ne 1 ]]; then
+  echo "display $DISPLAY is not answering" >&2
+  exit 1
+fi
+
+# Settings belong to the bot that owns the display: the runtime names its browser profile.
+if [[ -n "${CHROME_USER_DATA_DIR:-}" ]]; then
+  key="$(basename "$CHROME_USER_DATA_DIR")"
+else
+  key="primary"
+fi
+config="$HOME/.config/rakazo-desktop/$key"
+defaults=/etc/rakazo/desktop
+
+# Before the first desktop set up here, keep a copy of any Xfce settings already in this home.
+if [[ -d "$HOME/.config/xfce4" && ! -e "$HOME/.config/rakazo-desktop/backup" ]]; then
+  mkdir -p "$HOME/.config/rakazo-desktop/backup"
+  cp -a "$HOME/.config/xfce4" "$HOME/.config/rakazo-desktop/backup/xfce4-$(date +%Y%m%d%H%M%S)" || true
+fi
+
+# Defaults are written once; anything the bot or a person changes afterwards is kept.
+xml="$config/xfce4/xfconf/xfce-perchannel-xml"
+mkdir -p "$xml"
+for channel in xfce4-panel xfwm4; do
+  [[ -e "$xml/$channel.xml" ]] || cp "$defaults/$channel.xml" "$xml/$channel.xml"
+done
+for launcher in "$defaults"/launcher-*; do
+  name="$(basename "$launcher")"
+  [[ -d "$config/xfce4/panel/$name" ]] && continue
+  mkdir -p "$config/xfce4/panel/$name"
+  cp "$launcher"/*.desktop "$config/xfce4/panel/$name/"
+done
+
+# The panel and window manager read this display's settings; apps they start get the
+# bot's normal environment back from rakazo-desktop-launch.
+export XDG_CONFIG_HOME="$config"
+export GTK_THEME=Adwaita
+dbus-daemon --session --nofork --address="unix:path=$runtime/bus" >/dev/null 2>&1 &
+for _ in $(seq 1 50); do
+  [[ -S "$runtime/bus" ]] && break
+  sleep 0.1
+done
+if [[ ! -S "$runtime/bus" ]]; then
+  echo "desktop D-Bus session did not start" >&2
+  exit 1
+fi
+export DBUS_SESSION_BUS_ADDRESS="unix:path=$runtime/bus"
+
+xsetroot -solid "#d9dde3" >/dev/null 2>&1 || true
+
+wm_pid=""
+panel_pid=""
+start_wm() {
+  xfwm4 --compositor=off &
+  wm_pid=$!
+}
+start_panel() {
+  xfce4-panel --disable-wm-check &
+  panel_pid=$!
+}
+start_wm
+start_panel
+
+# Bring back whatever exits while the display is up; stop with the display.
+while xdpyinfo -display "$DISPLAY" >/dev/null 2>&1; do
+  sleep 2
+  kill -0 "$wm_pid" 2>/dev/null || start_wm
+  kill -0 "$panel_pid" 2>/dev/null || start_panel
+done
+echo "display $DISPLAY stopped" >&2
+cleanup
